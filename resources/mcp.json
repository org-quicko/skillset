            ],
            "additionalProperties": false
          },
          "outcomes": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "installed"
                    },
                    "skillDirectory": {
                      "type": "string"
                    },
                    "link": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "canonical"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "symlink"
                            },
                            "path": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "path"
                          ],
