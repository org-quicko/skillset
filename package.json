{
  "name": "@in-org-quicko/skillset",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --filter @in-org-quicko/skillset-api dev",
    "prebuild": "bun run lint",
    "build:web": "bun --filter @in-org-quicko/skillset-web build",
    "build:api": "bun --filter @in-org-quicko/skillset-api build",
    "build:cli": "bun --filter @in-org-quicko/skillset-cli build",
    "build:mcp": "bun --filter @in-org-quicko/skillset-mcp build",
    "build": "bun run build:web && bun run build:api && bun run build:cli && bun run build:mcp",
    "test": "bun run --filter @in-org-quicko/skillset-shared --filter @in-org-quicko/skillset-installer --filter @in-org-quicko/skillset-api --filter @in-org-quicko/skillset-cli --filter @in-org-quicko/skillset-mcp test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-tsdoc": "^0.3.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0"
  }
}
