{
  "name": "skillset",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --filter @skillset/api dev",
    "prebuild": "bun run lint",
    "build:web": "bun --filter @skillset/web build",
    "build:api": "bun --filter @skillset/api build",
    "build:cli": "bun --filter @skillset/cli build",
    "build": "bun run build:web && bun run build:api && bun run build:cli",
    "test": "bun run --filter @skillset/shared --filter @skillset/installer --filter @skillset/api --filter @skillset/cli --filter @skillset/mcp test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-tsdoc": "^0.3.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0"
  }
}
