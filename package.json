{
  "name": "@in-org-quicko/skillset",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "scripts": {
    "dev": "bun --filter @in-org-quicko/skillset-api dev",
    "prebuild": "bun run lint",
    "build:web": "bun --filter @in-org-quicko/skillset-web build",
    "build:api": "bun --filter @in-org-quicko/skillset-api build",
    "build:cli": "bun --filter @in-org-quicko/skillset-cli build",
    "build:mcp": "bun --filter @in-org-quicko/skillset-mcp build",
    "build": "bun run build:web && bun run build:api && bun run build:cli && bun run build:mcp",
    "test": "bun run --filter @in-org-quicko/skillset-shared --filter @in-org-quicko/skillset-installer --filter @in-org-quicko/skillset-api --filter @in-org-quicko/skillset-cli --filter @in-org-quicko/skillset-mcp --filter @in-org-quicko/skillset-web test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "audit": "bun audit --audit-level=high"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  }
}
