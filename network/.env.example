# Copy to .env (in this directory) and fill in before running `docker compose up`.
# Shared by both compose files here: docker-compose.yml (db-network,
# Postgres) and app.docker-compose.yml (sqillset, joining db-network
# externally). Start docker-compose.yml first so db-network exists.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=sqillset
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sqillset

# --- App (app.docker-compose.yml) -------------------------------------
# Host "postgres" is reachable because app.docker-compose.yml joins
# db-network; credentials and db name must match the Postgres block above.
# No search_path: DB_SCHEMA below places every object on its own.
DATABASE_URL=postgres://sqillset:changeme@postgres:5432/sqillset

# The schema this app's tables live in — the database is meant to be divided
# by schema (one per app) rather than dedicated to sqillset alone. Created by
# runMigrations on startup, which also resolves the schema the shipped
# migrations are written against. Leave unset to use `public`.
DB_SCHEMA=sqillset

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

PORT=3000
PUBLIC_URL=http://localhost:3000

STORAGE_BUCKET=sqillset
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
