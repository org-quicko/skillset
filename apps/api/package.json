{
  "name": "@in-org-quicko/skillset-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun run typecheck",
    "test": "bun test",
    "db:types": "bun scripts/generate-db-types.ts",
    "db:types:check": "bun scripts/generate-db-types.ts --verify"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@in-org-quicko/skillset-shared": "workspace:*",
    "better-auth": "^1.7.5",
    "hono": "^4.13.7",
    "kysely": "^0.29.6",
    "node-cron": "^4.6.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/bun": "^1.1.14",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^5.7.2"
  }
}
