# Copy to .env and fill in.
#
# For local development (`docker compose up`, i.e. docker-compose.yml), the
# defaults below work as-is — they match the Postgres and MinIO that file
# provisions for you.
#
# For production (`docker compose -f docker-compose.prod.yml up`), that file
# provisions Postgres too (from POSTGRES_USER/PASSWORD/DB below) but not
# object storage: point the STORAGE_* variables at your S3 (or S3-compatible)
# service, and generate a real BETTER_AUTH_SECRET. If you use a separate
# managed Postgres instead of the bundled one, point DATABASE_URL at it and
# POSTGRES_USER/PASSWORD/DB go unused.

# Postgres connection string. Must match POSTGRES_USER/PASSWORD/DB below when
# pointed at the bundled Postgres (both docker-compose.yml and
# docker-compose.prod.yml provision it at this host:port).
DATABASE_URL=postgres://postgres:postgres@postgres:5432/skill_registry

# Credentials the bundled Postgres container is created with. Only read by
# the `postgres` service itself, not by the app — DATABASE_URL above is what
# the app connects with, so keep the two in sync. Required in production
# (docker-compose.prod.yml has no default credentials); in local dev
# (docker-compose.yml) these default to postgres/postgres/skill_registry if
# unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skill_registry

# Signing secret for sessions. Required — the app refuses to start without it,
# because a generated one would silently invalidate every session on restart.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Port the application listens on.
PORT=3000

# Absolute base URL this Registry is reached at, with no trailing slash.
# Required (ADR-0016): every session cookie and OAuth redirect_uri is built
# from it, so the app refuses to start without one even with no Identity
# Provider configured.
#
# Register the redirect URI in each provider's console as
# <PUBLIC_URL>/api/auth/callback/<kind>, where <kind> is google, microsoft,
# or github — one per console, and note this is a path per kind rather than
# the single shared callback earlier versions used.
PUBLIC_URL=

# How often skill_analytics (install counts) is refreshed from the install
# event log, as a node-cron expression (seconds field first). Optional —
# defaults to every 30 seconds; the app refuses to start if this isn't a
# valid cron expression.
ANALYTICS_REFRESH_CRON=*/30 * * * * *

# Object storage (S3 or S3-compatible). STORAGE_BUCKET is required — publishing
# presigns uploads against it, so the app refuses to start without one. The
# values below match the MinIO that docker-compose.yml provisions, so local
# dev works with this file copied as-is. In production, use your real bucket,
# region, and credentials (e.g. an IAM user's or role's) instead — leave
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY unset to fall back to AWS's
# default credential chain (e.g. an instance/task role) rather than a
# long-lived key.
STORAGE_BUCKET=skill-registry
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
# Optional — set for a self-hosted S3-compatible endpoint (e.g. MinIO). Leave
# unset in production against real AWS S3.
STORAGE_ENDPOINT=http://minio:9000
# Optional — the endpoint embedded in presigned URLs, if the browser reaches
# storage at a different address than the API does (e.g. the API talks to
# MinIO over a Docker network hostname, but the browser needs localhost).
# Defaults to STORAGE_ENDPOINT. Leave unset in production against real AWS S3.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

LOG_LEVEL=info
